{
  "schemaVersion": 1,
  "scope": "project",
  "installPolicy": {
    "allowGlobal": false,
    "method": "copy",
    "nonInteractive": true,
    "overwriteExisting": true
  },
  "presets": {
    "default": [
      "github-copilot",
      "codex",
      "claude-code",
      "cursor"
    ]
  },
  "agents": {
    "codex": {
      "name": "Codex",
      "projectPath": ".agents/skills",
      "support": "required"
    },
    "claude-code": {
      "name": "Claude Code",
      "projectPath": ".claude/skills",
      "support": "required"
    },
    "github-copilot": {
      "name": "GitHub Copilot",
      "projectPath": ".agents/skills",
      "support": "required"
    },
    "cursor": {
      "name": "Cursor",
      "projectPath": ".agents/skills",
      "support": "required"
    }
  }
}
